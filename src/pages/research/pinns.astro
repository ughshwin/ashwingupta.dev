---
import { resolveCopy } from '../../content/portfolio/copy';

import documentContentSource from "../../content/portfolio/documents/research--pinns.json";
import { contentSchemas } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/index.css";
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;
const pdfUrl = documentContent.metadata.pdfurl;
const publicationUrl = documentContent.metadata.publicationurl;

---

<BaseLayout
  title={documentContent.metadata.baselayout_title}
  description={documentContent.metadata.baselayout_description}
  canonical={canonical}
  jsonLd={contentSchemas({
    type: "ScholarlyArticle",
    name: documentContent.metadata.schema_name,
    url: canonical,
    description: documentContent.metadata.baselayout_description,
    citation: publicationUrl,
    associatedMedia: {
      "@type": "MediaObject",
      name: documentContent.metadata.schema_name_2,
      contentUrl: new URL(pdfUrl, canonical).href,
      encodingFormat: "application/pdf",
    },
  })}
>
  <div class="spatial-scene">
    <div class="thinking-scroll">
      <div class="thinking-body" role="main">

        <a href={documentContent.links.back_to_section} class="back-link">{documentContent.blocks.intro_back_link}</a>

        <header class="th-header">
          <div class="th-badges">
            <span class="th-badge th-badge-award">{documentContent.blocks.intro_th_badge_th_badge_award}</span>
            <span class="th-badge th-badge-pub">{documentContent.blocks.intro_th_badge_th_badge_pub}</span>
          </div>
          <h1 class="th-title">{documentContent.blocks.header_title}</h1>
          <p class="th-subtitle">{documentContent.blocks.header_subtitle}</p>
        </header>

        <div class="th-divider"></div>

        <p class="th-bridge">
          {documentContent.blocks.research_arc_bridge}
        </p>

        <div class="th-tab-toggle">
          <button class="th-tab-btn active" data-tab="foundation">{documentContent.blocks.foundation_tab_label}</button>
          <button class="th-tab-btn" data-tab="enterprise">{documentContent.blocks.enterprise_tab_label}</button>
        </div>

        <!-- ═══ FOUNDATION PANEL (2023 thesis) ═══ -->
        <div class="th-tab-panel active" data-panel="foundation">

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.the_problem_with_data_driven_physics_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.the_problem_with_data_driven_physics_th_body}
            </p>
            <p class="th-body">
              {documentContent.blocks.the_problem_with_data_driven_physics_th_body_2}
            </p>
          </section>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.the_framework_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.the_framework_th_body}
            </p>
            <p class="th-body">
              {documentContent.blocks.the_framework_th_body_2}
            </p>
          </section>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.validation_across_six_benchmarks_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.validation_across_six_benchmarks_th_body}
            </p>
            <p class="th-body">
              {documentContent.blocks.validation_across_six_benchmarks_th_body_2}
            </p>
            <p class="th-body">
              {documentContent.blocks.validation_across_six_benchmarks_th_body_3}
            </p>
          </section>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.what_this_means_in_practice_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.what_this_means_in_practice_th_body}
            </p>
            <p class="th-body">
              {documentContent.blocks.what_this_means_in_practice_th_body_2}
            </p>
          </section>

        </div>

        <!-- ═══ ENTERPRISE PANEL (2025 white paper) ═══ -->
        <div class="th-tab-panel" data-panel="enterprise">

          <div class="th-pub-meta">{documentContent.blocks.what_this_means_in_practice_th_pub_meta}</div>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.the_enterprise_problem_operating_blind_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.the_enterprise_problem_operating_blind_th_body}
            </p>
            <p class="th-body">
              {documentContent.blocks.the_enterprise_problem_operating_blind_th_body_2} <strong>{documentContent.blocks.the_enterprise_problem_operating_blind_strong}</strong> {documentContent.blocks.the_enterprise_problem_operating_blind_th_body_3}
            </p>
          </section>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.when_pinns_are_justified_and_when_they_are_not_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.when_pinns_are_justified_and_when_they_are_not_th_body} <strong>{documentContent.blocks.when_pinns_are_justified_and_when_they_are_not_strong}</strong> {documentContent.blocks.when_pinns_are_justified_and_when_they_are_not_th_body_2}
            </p>
            <p class="th-body">
              {documentContent.blocks.when_pinns_are_justified_and_when_they_are_not_th_body_3} <strong>{documentContent.blocks.when_pinns_are_justified_and_when_they_are_not_strong_2}</strong> {documentContent.blocks.when_pinns_are_justified_and_when_they_are_not_th_body_4}
            </p>
          </section>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.the_canonical_enterprise_pattern_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.the_canonical_enterprise_pattern_th_body} <strong>{documentContent.blocks.the_canonical_enterprise_pattern_strong}</strong>{documentContent.blocks.the_canonical_enterprise_pattern_th_body_2}
            </p>
            <p class="th-body">
              {documentContent.blocks.the_canonical_enterprise_pattern_th_body_3} <strong>{documentContent.blocks.the_canonical_enterprise_pattern_strong_2}</strong>{documentContent.blocks.the_canonical_enterprise_pattern_th_body_4}
            </p>
          </section>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.six_workflows_two_verticals_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.six_workflows_two_verticals_th_body}
            </p>
            <p class="th-body">
              <strong>{documentContent.blocks.six_workflows_two_verticals_strong}</strong> {documentContent.blocks.six_workflows_two_verticals_th_body_2}
            </p>
            <p class="th-body">
              <strong>{documentContent.blocks.six_workflows_two_verticals_strong_2}</strong> {documentContent.blocks.six_workflows_two_verticals_th_body_3}
            </p>
            <p class="th-body">
              {documentContent.blocks.six_workflows_two_verticals_th_body_4}
            </p>
          </section>

          <section class="th-section">
            <h2 class="th-section-title">{documentContent.blocks.the_honest_trade_offs_th_section_title}</h2>
            <p class="th-body">
              {documentContent.blocks.the_honest_trade_offs_th_body}
            </p>
            <p class="th-body">
              {documentContent.blocks.the_honest_trade_offs_th_body_2} <strong>{documentContent.blocks.the_honest_trade_offs_strong}</strong>
            </p>
          </section>

          <div class="th-cta-row">
            <a href={publicationUrl} target="_blank" rel="noopener noreferrer" class="cta-link">
              {documentContent.blocks.the_honest_trade_offs_cta_link}
            </a>
            <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="cta-link">
              {documentContent.blocks.the_honest_trade_offs_cta_link_2}
            </a>
          </div>

        </div>

        <div class="th-footer">
          <span>{documentContent.blocks.the_honest_trade_offs_span}</span>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function switchTab(tabName) {
    document.querySelectorAll('.th-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('.th-tab-panel').forEach(function(p) { p.classList.remove('active'); });
    var btn = document.querySelector('.th-tab-btn[data-tab="' + tabName + '"]');
    var panel = document.querySelector('.th-tab-panel[data-panel="' + tabName + '"]');
    if (btn) btn.classList.add('active');
    if (panel) panel.classList.add('active');
  }

  function initTabs() {
    document.querySelectorAll('.th-tab-btn').forEach(function(btn) {
      btn.addEventListener('click', function() { switchTab(btn.dataset.tab); });
    });
    document.querySelector('.thinking-body')?.classList.add('th-tabs-ready');
  }

  document.addEventListener('astro:page-load', initTabs);
  initTabs();
</script>

<style>
  body {
    background: #060608;
    margin: 0;
    padding: 0;
  }

  .thinking-scroll {
    overflow-y: auto;
    height: 100vh;
    position: relative;
    z-index: 10;
  }

  .thinking-body {
    width: max(320px, 60vw);
    margin: 0 auto;
    padding: 5rem 0 8rem;
  }

  @media (min-width: 640px) {
    .thinking-body {
      padding: 7rem 0 8rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-bottom: 3.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: rgba(255, 255, 255, 0.9); }

  .th-header { margin-bottom: 2.5rem; }

  .th-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .th-badge {
    font-family: 'DM Mono', monospace;
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid rgba(34, 211, 238, 0.4);
    background: rgba(34, 211, 238, 0.06);
    color: #22d3ee;
  }

  .th-badge-pub {
    border-color: rgba(16, 185, 129, 0.45);
    background: rgba(16, 185, 129, 0.08);
    color: #10b981;
  }

  .th-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.05em;
    color: #fafaf8;
    margin: 0 0 0.75rem;
  }

  .th-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    text-align: justify;
  }

  .th-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 2rem 0;
  }

  .th-bridge {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.55);
    font-style: italic;
    border-left: 2px solid rgba(34, 211, 238, 0.35);
    padding-left: 1rem;
    margin: 0 0 2.5rem;
    text-align: justify;
  }

  /* ── Tabs ── */
  .th-tab-toggle {
    display: none;
    gap: 2rem;
    margin: 0 0 2.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .th-tab-btn {
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.55);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 0 0.5rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .th-tab-btn.active {
    color: #22d3ee;
    border-bottom: 2px solid #22d3ee;
  }

  .th-tab-btn:hover { color: rgba(255, 255, 255, 0.85); }

  /* JavaScript enhances the document; it is not required to read either panel. */
  .th-tab-panel { display: block; }
  .th-tabs-ready .th-tab-toggle { display: flex; }
  .th-tabs-ready .th-tab-panel:not(.active) { display: none; }

  .th-pub-meta {
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(34, 211, 238, 0.8);
    margin-bottom: 2rem;
  }

  .th-section { margin-bottom: 3.5rem; }

  .th-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fafaf8;
    margin: 0 0 1.2rem;
    letter-spacing: 0.05em;
  }

  .th-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 0 1rem;
    text-align: justify;
  }

  .th-body strong { color: #e8e0d0; font-weight: 600; }

  .th-cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #22d3ee;
    text-decoration: none;
    border: 1px solid rgba(34, 211, 238, 0.35);
    border-radius: 4px;
    padding: 8px 14px;
    transition: background 0.2s;
  }
  .cta-link:hover { background: rgba(34, 211, 238, 0.08); }

  .th-footer {
    margin-top: 6rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
  }
</style>
