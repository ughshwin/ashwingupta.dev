---
import { resolveCopy } from '../../content/portfolio/copy';

import documentContentSource from "../../content/portfolio/documents/research--controla.json";
import { contentSchemas } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/index.css";
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;

---

<BaseLayout
  title={documentContent.metadata.baselayout_title}
  description={documentContent.metadata.baselayout_description}
  canonical={canonical}
  jsonLd={contentSchemas({
    type: "CreativeWork",
    name: documentContent.metadata.schema_name,
    url: canonical,
    description: documentContent.metadata.baselayout_description,
  })}
>
  <div class="spatial-scene">
    <div class="thinking-scroll">
      <div class="thinking-body" role="main">

        <!-- Back link -->
        <a href={documentContent.links.back_to_section} class="back-link">{documentContent.blocks.intro_back_link}</a>

        <!-- Header -->
        <header class="th-header">
          <div class="th-badge">{documentContent.blocks.intro_th_badge}</div>
          <h1 class="th-title">{documentContent.blocks.controla_local_inference_that_learns_th_title}</h1>
          <p class="th-subtitle">{documentContent.blocks.controla_local_inference_that_learns_th_subtitle}</p>
        </header>

        <div class="th-divider"></div>

        <!-- Section 1: What's Wrong With How Everyone Does Inference Routing -->
        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.what_s_wrong_with_inference_routing_today_th_section_title}</h2>
          <p class="th-body">
            {documentContent.blocks.what_s_wrong_with_inference_routing_today_th_body}
          </p>
          <p class="th-body">
            {documentContent.blocks.what_s_wrong_with_inference_routing_today_th_body_2}
          </p>
          <p class="th-body">
            {documentContent.blocks.what_s_wrong_with_inference_routing_today_th_body_3}
          </p>
          <p class="th-body">
            {documentContent.blocks.what_s_wrong_with_inference_routing_today_th_body_4}
          </p>
        </section>

        <!-- Section 2: Why Statefulness Matters -->
        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.why_statefulness_matters_th_section_title}</h2>
          <p class="th-body">
            {documentContent.blocks.why_statefulness_matters_th_body}
          </p>
          <p class="th-body">
            {documentContent.blocks.why_statefulness_matters_th_body_2} <strong>{documentContent.blocks.why_statefulness_matters_strong}</strong> {documentContent.blocks.why_statefulness_matters_th_body_3} <code>{documentContent.blocks.why_statefulness_matters_code}</code> {documentContent.blocks.why_statefulness_matters_th_body_4}
          </p>
          <p class="th-body">
            {documentContent.blocks.why_statefulness_matters_th_body_5}
          </p>
          <p class="th-body">
            {documentContent.blocks.why_statefulness_matters_th_body_6}
          </p>
        </section>

        <!-- Section 3: The System -->
        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_system_th_section_title}</h2>
          <p class="th-body">
            {documentContent.blocks.the_system_th_body}
          </p>
          <div class="pipeline-list">
            <div class="pipeline-step">
              <span class="pipeline-label">{documentContent.blocks.the_system_pipeline_label}</span>
              <span class="pipeline-desc">{documentContent.blocks.the_system_pipeline_desc}</span>
            </div>
            <div class="pipeline-step">
              <span class="pipeline-label">{documentContent.blocks.the_system_pipeline_label_2}</span>
              <span class="pipeline-desc">{documentContent.blocks.the_system_pipeline_desc_2}</span>
            </div>
            <div class="pipeline-step">
              <span class="pipeline-label">{documentContent.blocks.the_system_pipeline_label_3}</span>
              <span class="pipeline-desc">{documentContent.blocks.the_system_pipeline_desc_3}</span>
            </div>
            <div class="pipeline-step">
              <span class="pipeline-label">{documentContent.blocks.the_system_pipeline_label_4}</span>
              <span class="pipeline-desc">{documentContent.blocks.the_system_pipeline_desc_4}</span>
            </div>
            <div class="pipeline-step">
              <span class="pipeline-label">{documentContent.blocks.the_system_pipeline_label_5}</span>
              <span class="pipeline-desc">{documentContent.blocks.the_system_pipeline_desc_5}</span>
            </div>
            <div class="pipeline-step">
              <span class="pipeline-label">{documentContent.blocks.the_system_pipeline_label_6}</span>
              <span class="pipeline-desc">{documentContent.blocks.the_system_pipeline_desc_6}</span>
            </div>
          </div>
        </section>

        <!-- Section 4: What Building It Revealed -->
        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.what_building_it_revealed_th_section_title}</h2>
          <p class="th-body">
            {documentContent.blocks.what_building_it_revealed_th_body}
          </p>
          <p class="th-body">
            {documentContent.blocks.what_building_it_revealed_th_body_2}
          </p>
          <p class="th-body">
            {documentContent.blocks.what_building_it_revealed_th_body_3}
          </p>
          <p class="th-body">
            {documentContent.blocks.what_building_it_revealed_th_body_4}
          </p>
        </section>

        <!-- Section 5: Where It Is Now -->
        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.where_it_is_now_th_section_title}</h2>
          <p class="th-body">
            {documentContent.blocks.where_it_is_now_th_body}
          </p>
          <p class="th-body">
            {documentContent.blocks.where_it_is_now_th_body_2}
          </p>
          <p class="th-body">
            {documentContent.blocks.where_it_is_now_th_body_3}
          </p>
          <p class="th-body cs-subtle">
            {documentContent.blocks.where_it_is_now_th_body_cs_subtle}
          </p>
        </section>

        <!-- Footer -->
        <div class="th-footer">
          <span>{documentContent.blocks.where_it_is_now_span}</span>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  body {
    background: #060608;
    margin: 0;
    padding: 0;
  }

  .environment-placeholder {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 60% 30%, rgba(20, 15, 45, 0.6) 0%, #060608 65%);
    z-index: 0;
  }

  .thinking-scroll {
    overflow-y: auto;
    height: 100vh;
    position: relative;
    z-index: 10;
  }

  .thinking-body {
    width: max(320px, 60vw);
    margin: 0 auto;
    padding: 5rem 0 8rem;
  }

  @media (min-width: 640px) {
    .thinking-body {
      padding: 7rem 0 8rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-bottom: 3.5rem;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: rgba(255, 255, 255, 0.9);
  }

  .th-header {
    margin-bottom: 2.5rem;
  }

  .th-badge {
    font-family: 'DM Mono', monospace;
    font-size: 0.54rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 1rem;
  }

  .th-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.05em;
    color: #fafaf8;
    margin: 0 0 0.75rem;
  }

  .th-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    text-align: justify;
  }

  .th-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 2rem 0;
  }

  .th-section {
    margin-bottom: 3.5rem;
  }

  .th-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fafaf8;
    margin: 0 0 1.2rem;
    letter-spacing: 0.05em;
  }

  .th-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 0 1rem;
    text-align: justify;
  }

  .th-body code {
    font-family: 'DM Mono', monospace;
    font-size: 0.85em;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.06);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .th-body strong {
    color: #e8e0d0;
    font-weight: 600;
  }

  .cs-subtle {
    color: rgba(255, 255, 255, 0.38);
    font-style: italic;
  }

  .pipeline-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 1.5rem 0;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    overflow: hidden;
  }

  .pipeline-step {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .pipeline-step:last-child {
    border-bottom: none;
  }

  .pipeline-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(34, 211, 238, 0.7);
    padding-top: 2px;
  }

  .pipeline-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.83rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    text-align: justify;
  }

  .th-footer {
    margin-top: 6rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
  }
</style>
