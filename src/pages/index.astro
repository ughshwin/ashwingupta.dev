---
import { resolveCopy } from '../content/portfolio/copy';

import documentContentSource from "../content/portfolio/documents/index.json";
import { profileSchema, paperSchema } from "../lib/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioHome from '../components/static/PortfolioHome.astro';
import { homeContents } from '../content/portfolio/home';
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;


---

<BaseLayout
  canonical={canonical}
  jsonLd={[profileSchema, paperSchema]}
  nativeHome
  contents={homeContents}
>
  <PortfolioHome />
</BaseLayout>
