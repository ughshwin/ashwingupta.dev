---
import { resolveCopy } from '../../content/portfolio/copy';

import documentContentSource from "../../content/portfolio/documents/work--skill-recommendation-engine.json";
import { contentSchemas } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/index.css";
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;

const metrics = documentContent.data.metrics;

---

<BaseLayout
  title={documentContent.metadata.baselayout_title}
  description={documentContent.metadata.baselayout_description}
  canonical={canonical}
  jsonLd={contentSchemas({
    type: "CreativeWork",
    name: documentContent.metadata.schema_name,
    url: canonical,
    description: documentContent.metadata.baselayout_description,
  })}
>
  <div class="spatial-scene">
    <div class="thinking-scroll">
      <div class="thinking-body" role="main">

        <a href={documentContent.links.back_to_section} class="back-link">{documentContent.blocks.intro_back_link}</a>

        <header class="th-header">
          <div class="th-badge">{documentContent.blocks.intro_th_badge}</div>
          <h1 class="th-title">{documentContent.blocks.graph_based_skill_recommendation_engine_th_title}</h1>
          <p class="th-subtitle">{documentContent.blocks.graph_based_skill_recommendation_engine_th_subtitle}</p>
        </header>

        <div class="th-divider"></div>

        <div class="metrics-grid">
          {metrics.map(({ value, label }) => (
            <div class="metric-block">
              <span class="metric-value">{value}</span>
              <span class="metric-label">{label}</span>
            </div>
          ))}
        </div>

        <div class="th-divider"></div>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_problem_th_section_title}</h2>
          <p class="th-body">
            {documentContent.blocks.the_problem_th_body}
          </p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_system_th_section_title}</h2>
          <p class="th-body">
            {documentContent.blocks.the_system_th_body} <strong>{documentContent.blocks.the_system_strong}</strong> {documentContent.blocks.the_system_th_body_2}
          </p>
          <p class="th-body">
            {documentContent.blocks.the_system_th_body_3} <strong>{documentContent.blocks.the_system_strong_2}</strong> {documentContent.blocks.the_system_th_body_4}
          </p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.outcomes_th_section_title}</h2>
          <p class="th-body">
            <strong>{documentContent.blocks.outcomes_strong}</strong> {documentContent.blocks.outcomes_th_body} <strong>{documentContent.blocks.outcomes_strong_2}</strong> {documentContent.blocks.outcomes_th_body_2}
          </p>
        </section>

        <div class="th-footer">
          <span>{documentContent.blocks.outcomes_span}</span>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  body {
    background: #060608;
    margin: 0;
    padding: 0;
  }

  .thinking-scroll {
    overflow-y: auto;
    height: 100vh;
    position: relative;
    z-index: 10;
  }

  .thinking-body {
    width: max(320px, 60vw);
    margin: 0 auto;
    padding: 5rem 0 8rem;
  }

  @media (min-width: 640px) {
    .thinking-body {
      padding: 7rem 0 8rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-bottom: 3.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: rgba(255, 255, 255, 0.9); }

  .th-header { margin-bottom: 2.5rem; }

  .th-badge {
    font-family: 'DM Mono', monospace;
    font-size: 0.54rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 1rem;
  }

  .th-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.05em;
    color: #fafaf8;
    margin: 0 0 0.75rem;
  }

  .th-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    text-align: justify;
  }

  .th-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 2rem 0;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.2rem;
    margin: 2rem 0;
  }

  .metric-block { display: flex; flex-direction: column; gap: 4px; }

  .metric-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    color: #22d3ee;
    line-height: 1;
  }

  .metric-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    line-height: 1.4;
  }

  .th-section { margin-bottom: 3.5rem; }

  .th-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fafaf8;
    margin: 0 0 1.2rem;
    letter-spacing: 0.05em;
  }

  .th-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 0 1rem;
    text-align: justify;
  }

  .th-body strong { color: #e8e0d0; font-weight: 600; }

  .th-footer {
    margin-top: 6rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
  }
</style>
