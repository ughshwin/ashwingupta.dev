---
import { resolveCopy } from '../../content/portfolio/copy';

import documentContentSource from "../../content/portfolio/documents/work--here-app.json";
import { contentSchemas } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/index.css";
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;

const metrics = documentContent.data.metrics;

---

<BaseLayout
  title={documentContent.metadata.baselayout_title}
  description={documentContent.metadata.baselayout_description}
  canonical={canonical}
  jsonLd={contentSchemas({
    type: "CreativeWork",
    name: documentContent.metadata.schema_name,
    url: canonical,
    description: documentContent.metadata.baselayout_description,
  })}
>
  <div class="spatial-scene">
    <div class="hologram-interface case-study-scroll">
      <div class="case-study-body" role="main">

        <a href={documentContent.links.back_to_section} class="back-link">{documentContent.blocks.intro_back_link}</a>

        <header class="cs-header">
          <div class="cs-context-badge">{documentContent.blocks.intro_cs_context_badge}</div>
          <h1 class="cs-title">{documentContent.blocks.header_title}</h1>
          <p class="cs-subtitle">
            {documentContent.blocks.header_subtitle}
          </p>
        </header>

        <div class="cs-divider"></div>

        <div class="metrics-grid">
          {metrics.map(({ value, label }) => (
            <div class="metric-block">
              <span class="metric-value">{value}</span>
              <span class="metric-label">{label}</span>
            </div>
          ))}
        </div>

        <div class="cs-divider"></div>

        <section class="cs-section">
          <h2 class="cs-section-title">{documentContent.blocks.the_problem_cs_section_title}</h2>
          <p class="cs-body">
            {documentContent.blocks.the_problem_cs_body}
          </p>
          <p class="cs-body">
            {documentContent.blocks.the_problem_cs_body_2}
          </p>
        </section>

        <section class="cs-section">
          <h2 class="cs-section-title">{documentContent.blocks.why_standard_rag_fails_at_163_languages_cs_section_title}</h2>
          <p class="cs-body">
            {documentContent.blocks.why_standard_rag_fails_at_163_languages_cs_body}
          </p>
          <p class="cs-body">
            {documentContent.blocks.why_standard_rag_fails_at_163_languages_cs_body_2}
          </p>
        </section>

        <section class="cs-section">
          <h2 class="cs-section-title">{documentContent.blocks.the_system_cs_section_title}</h2>
          <p class="cs-body">
            {documentContent.blocks.the_system_cs_body}
          </p>
          <p class="cs-body">
            {documentContent.blocks.the_system_cs_body_2}
          </p>
          <p class="cs-body">
            {documentContent.blocks.the_system_cs_body_3}
          </p>
        </section>

        <section class="cs-section">
          <h2 class="cs-section-title">{documentContent.blocks.outcomes_cs_section_title}</h2>
          <div class="outcomes-list">
            <div class="outcome-item">
              <span class="outcome-metric">{documentContent.blocks.outcomes_outcome_metric}</span>
              <span class="outcome-detail">{documentContent.blocks.outcomes_outcome_detail}</span>
            </div>
            <div class="outcome-item">
              <span class="outcome-metric">{documentContent.blocks.outcomes_outcome_metric_2}</span>
              <span class="outcome-detail">{documentContent.blocks.outcomes_outcome_detail_2}</span>
            </div>
            <div class="outcome-item">
              <span class="outcome-metric">{documentContent.blocks.outcomes_outcome_metric_3}</span>
              <span class="outcome-detail">{documentContent.blocks.outcomes_outcome_detail_3}</span>
            </div>
            <div class="outcome-item">
              <span class="outcome-metric">{documentContent.blocks.outcomes_outcome_metric_4}</span>
              <span class="outcome-detail">{documentContent.blocks.outcomes_outcome_detail_4}</span>
            </div>
          </div>
        </section>

        <div class="cs-footer">
          <span>{documentContent.blocks.outcomes_span}</span>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  body {
    background: #060608;
    margin: 0;
    padding: 0;
  }

  .case-study-scroll {
    overflow-y: auto;
    height: 100vh;
    position: relative;
    z-index: 10;
  }

  .case-study-body {
    width: max(320px, 60vw);
    margin: 0 auto;
    padding: 5rem 0 8rem;
  }

  @media (min-width: 640px) {
    .case-study-body {
      padding: 7rem 0 8rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-bottom: 3.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: rgba(255, 255, 255, 0.9); }

  .cs-header { margin-bottom: 2.5rem; }

  .cs-context-badge {
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 1rem;
  }

  .cs-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.05em;
    color: #fafaf8;
    margin: 0 0 1rem;
  }

  .cs-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    text-align: justify;
  }

  .cs-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 2rem 0;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.2rem;
    margin: 2rem 0;
  }

  .metric-block { display: flex; flex-direction: column; gap: 4px; }

  .metric-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    color: #22d3ee;
    line-height: 1;
  }

  .metric-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    line-height: 1.4;
  }

  .cs-section { margin-bottom: 3.5rem; }

  .cs-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fafaf8;
    margin: 0 0 1.2rem;
    letter-spacing: 0.05em;
  }

  .cs-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 0 1rem;
    text-align: justify;
  }

  .cs-body strong { color: #e8e0d0; font-weight: 600; }

  .outcomes-list { display: flex; flex-direction: column; gap: 0; }

  .outcome-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .outcome-metric {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #e8e0d0;
  }

  .outcome-detail {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.35);
  }

  .cs-footer {
    margin-top: 6rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
  }
</style>
