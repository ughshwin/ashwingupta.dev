---
import { resolveCopy } from '../../content/portfolio/copy';

import documentContentSource from "../../content/portfolio/documents/work--hsbc.json";
import { contentSchemas } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/index.css";
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;

const metrics = documentContent.data.metrics;

---

<BaseLayout
  title={documentContent.metadata.baselayout_title}
  description={documentContent.metadata.baselayout_description}
  canonical={canonical}
  jsonLd={contentSchemas({
    type: "CreativeWork",
    name: documentContent.metadata.schema_name,
    url: canonical,
    description: documentContent.metadata.baselayout_description,
  })}
>
  <div class="spatial-scene">
    <div class="hologram-interface case-study-scroll">
      <div class="case-study-body" role="main">

        <a href={documentContent.links.back_to_section} class="back-link">{documentContent.blocks.intro_back_link}</a>

        <header class="cs-header">
          <div class="cs-context-badge">{documentContent.blocks.intro_cs_context_badge}</div>
          <h1 class="cs-title">{documentContent.blocks.conversational_analytics_hsbc_cs_title}</h1>
          <p class="cs-subtitle">
            {documentContent.blocks.conversational_analytics_hsbc_cs_subtitle}
          </p>
        </header>

        <div class="cs-divider"></div>

        <div class="metrics-grid">
          {metrics.map(({ value, label }) => (
            <div class="metric-block">
              <span class="metric-value">{value}</span>
              <span class="metric-label">{label}</span>
            </div>
          ))}
        </div>

        <div class="cs-divider"></div>

        <div class="cs-delta-heading">{documentContent.blocks.conversational_analytics_hsbc_cs_delta_heading}</div>
        <table class="cs-delta-table">
          <thead>
            <tr>
              <th></th>
              <th>{documentContent.blocks.infrastructure_before_heading}</th>
              <th>{documentContent.blocks.infrastructure_after_heading}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{documentContent.blocks.infrastructure_vm_label}</td>
              <td>{documentContent.blocks.infrastructure_vm_before}</td>
              <td>{documentContent.blocks.infrastructure_vm_after}</td>
            </tr>
            <tr>
              <td>{documentContent.blocks.infrastructure_application_label}</td>
              <td>{documentContent.blocks.infrastructure_application_before}</td>
              <td>{documentContent.blocks.infrastructure_application_after}</td>
            </tr>
            <tr>
              <td>{documentContent.blocks.infrastructure_observability_label}</td>
              <td>{documentContent.blocks.infrastructure_observability_before}</td>
              <td>{documentContent.blocks.infrastructure_observability_after}</td>
            </tr>
          </tbody>
        </table>

        <div class="cs-divider"></div>

        <div class="cs-tab-toggle">
          <button class="cs-tab-btn active" data-tab="before">{documentContent.blocks.infrastructure_before_heading}</button>
          <button class="cs-tab-btn" data-tab="after">{documentContent.blocks.infrastructure_after_heading}</button>
        </div>

        <!-- ═══ BEFORE PANEL ═══ -->
        <div class="cs-tab-panel active" data-panel="before">

          <section class="cs-section">
            <h2 class="cs-section-title">{documentContent.blocks.the_constraint_environment_cs_section_title}</h2>
            <p class="cs-body">
              {documentContent.blocks.the_constraint_environment_cs_body}
            </p>
            <p class="cs-body">
              {documentContent.blocks.the_constraint_environment_cs_body_2}
            </p>
            <p class="cs-body">
              {documentContent.blocks.the_constraint_environment_cs_body_3}
            </p>
          </section>

          <section class="cs-section">
            <h2 class="cs-section-title">{documentContent.blocks.what_was_actually_broken_cs_section_title}</h2>
            <p class="cs-body">
              {documentContent.blocks.what_was_actually_broken_cs_body}
            </p>
            <p class="cs-body">
              {documentContent.blocks.what_was_actually_broken_cs_body_2} <code>{documentContent.blocks.what_was_actually_broken_code}</code> {documentContent.blocks.what_was_actually_broken_cs_body_3} <code>{documentContent.blocks.what_was_actually_broken_code_2}</code> {documentContent.blocks.what_was_actually_broken_cs_body_4}
            </p>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.what_was_actually_broken_cs_diagram_label}</span>
              <pre class="mermaid">{documentContent.diagrams.what_was_actually_broken_mermaid}</pre>
            </div>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.what_was_actually_broken_cs_diagram_label_2}</span>
              <pre class="mermaid">{documentContent.diagrams.what_was_actually_broken_mermaid_2}</pre>
            </div>
          </section>

          <section class="cs-section">
            <h2 class="cs-section-title">{documentContent.blocks.observability_before_cs_section_title}</h2>
            <p class="cs-body">
              {documentContent.blocks.observability_before_cs_body}
            </p>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.observability_before_cs_diagram_label}</span>
              <pre class="mermaid">{documentContent.diagrams.observability_before_mermaid}</pre>
            </div>
          </section>

        </div>

        <!-- ═══ AFTER PANEL ═══ -->
        <div class="cs-tab-panel" data-panel="after">

          <section class="cs-section">
            <h2 class="cs-section-title">{documentContent.blocks.the_architecture_decision_cs_section_title}</h2>
            <p class="cs-body">
              {documentContent.blocks.the_architecture_decision_cs_body}
            </p>
            <p class="cs-body">
              {documentContent.blocks.the_architecture_decision_cs_body_2} <code>{documentContent.blocks.the_architecture_decision_code}</code> {documentContent.blocks.the_architecture_decision_cs_body_3}
            </p>
            <p class="cs-body">
              {documentContent.blocks.the_architecture_decision_cs_body_4}
            </p>
            <p class="cs-body">
              {documentContent.blocks.the_architecture_decision_cs_body_5} <strong>{documentContent.blocks.the_architecture_decision_strong}</strong> {documentContent.blocks.the_architecture_decision_cs_body_6}
            </p>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.the_architecture_decision_cs_diagram_label}</span>
              <pre class="mermaid">{documentContent.diagrams.the_architecture_decision_mermaid}</pre>
            </div>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.the_architecture_decision_cs_diagram_label_2}</span>
              <pre class="mermaid">{documentContent.diagrams.the_architecture_decision_mermaid_2}</pre>
            </div>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.the_architecture_decision_cs_diagram_label_3}</span>
              <pre class="mermaid">{documentContent.diagrams.the_architecture_decision_mermaid_3}</pre>
            </div>
          </section>

          <section class="cs-section">
            <h2 class="cs-section-title">{documentContent.blocks.observability_after_cs_section_title}</h2>
            <p class="cs-body">
              {documentContent.blocks.observability_after_cs_body}
            </p>
            <p class="cs-body">
              {documentContent.blocks.observability_after_cs_body_2}
            </p>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.observability_after_cs_diagram_label}</span>
              <pre class="mermaid">{documentContent.diagrams.observability_after_mermaid}</pre>
            </div>

            <div class="cs-diagram-container">
              <span class="cs-diagram-label">{documentContent.blocks.observability_after_cs_diagram_label_2}</span>
              <pre class="mermaid">{documentContent.diagrams.observability_after_mermaid_2}</pre>
            </div>

          </section>

          <section class="cs-section">
            <h2 class="cs-section-title">{documentContent.blocks.what_a_senior_engineer_should_take_away_cs_section_title}</h2>
            <p class="cs-body">
              {documentContent.blocks.what_a_senior_engineer_should_take_away_cs_body}
            </p>
            <p class="cs-body">
              {documentContent.blocks.what_a_senior_engineer_should_take_away_cs_body_2}
            </p>
            <p class="cs-body">
              {documentContent.blocks.what_a_senior_engineer_should_take_away_cs_body_3}
            </p>
          </section>

        </div>

        <div class="cs-footer">
          <span>{documentContent.blocks.what_a_senior_engineer_should_take_away_span}</span>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline src="/vendor/mermaid.min.js"></script>
<script is:inline>
  var MERMAID_CONFIG = {
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      background: 'transparent',
      primaryColor: 'transparent',
      primaryTextColor: '#ffffff',
      primaryBorderColor: 'rgba(255,255,255,0.28)',
      secondaryColor: 'transparent',
      secondaryTextColor: '#ffffff',
      tertiaryColor: 'transparent',
      tertiaryTextColor: '#ffffff',
      lineColor: 'rgba(255,255,255,0.55)',
      textColor: '#ffffff',
      mainBkg: 'transparent',
      nodeBorder: 'rgba(255,255,255,0.28)',
      clusterBkg: 'rgba(255,255,255,0.03)',
      clusterBorder: 'rgba(255,255,255,0.15)',
      titleColor: '#ffffff',
      edgeLabelBackground: 'rgba(6,6,8,0.7)',
      fontSize: '12px',
      actorBkg: 'transparent',
      actorTextColor: '#ffffff',
      actorLineColor: 'rgba(255,255,255,0.3)',
      signalColor: 'rgba(255,255,255,0.55)',
      signalTextColor: '#ffffff',
      labelBoxBkgColor: 'transparent',
      labelBoxBorderColor: 'rgba(255,255,255,0.2)',
      labelTextColor: '#ffffff',
      loopTextColor: '#ffffff',
      noteBkgColor: 'rgba(255,255,255,0.04)',
      noteTextColor: '#ffffff',
      noteBorderColor: 'rgba(255,255,255,0.2)',
      activationBkgColor: 'rgba(255,255,255,0.06)',
      activationBorderColor: 'rgba(255,255,255,0.3)',
    },
  };

  // review-paint:start
  // The Review edition changes colour only. The original theme, diagram source,
  // renderer, measurement context and both tab lifecycles remain shared.
  if (document.body.classList.contains('review-edition')) {
    Object.keys(MERMAID_CONFIG.themeVariables).forEach(function(key) {
      var value = MERMAID_CONFIG.themeVariables[key];
      if (typeof value === 'string') {
        MERMAID_CONFIG.themeVariables[key] = value
          .replace(/#ffffff/gi, '#1d293b')
          .replace(/rgba\(255,255,255,([^)]+)\)/g, 'rgba(29,41,59,$1)');
      }
    });
    MERMAID_CONFIG.themeVariables.edgeLabelBackground = 'transparent';
  }
  // review-paint:end

  function runMermaidIn(panel) {
    if (!panel) return;
    var nodes = Array.from(panel.querySelectorAll('.mermaid:not([data-processed])'));
    if (nodes.length) mermaid.run({ nodes: nodes });
  }

  function switchTab(tabName) {
    document.querySelectorAll('.cs-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('.cs-tab-panel').forEach(function(p) { p.classList.remove('active'); });
    var btn = document.querySelector('.cs-tab-btn[data-tab="' + tabName + '"]');
    var panel = document.querySelector('.cs-tab-panel[data-panel="' + tabName + '"]');
    if (btn) btn.classList.add('active');
    if (panel) { panel.classList.add('active'); runMermaidIn(panel); }
  }

  function init() {
    mermaid.initialize(MERMAID_CONFIG);
    runMermaidIn(document.querySelector('.cs-tab-panel[data-panel="before"]'));
    document.querySelectorAll('.cs-tab-btn').forEach(function(btn) {
      btn.addEventListener('click', function() { switchTab(btn.dataset.tab); });
    });
    document.querySelector('.case-study-body')?.classList.add('cs-tabs-ready');
  }

  function tryInit() {
    if (typeof mermaid === 'undefined') { setTimeout(tryInit, 30); return; }
    if (tryInit._done) return;
    tryInit._done = true;
    init();
  }

  document.addEventListener('astro:page-load', function() { tryInit._done = false; tryInit(); });
  tryInit();
</script>

<style is:global>
  body {
    background: #060608;
    margin: 0;
    padding: 0;
  }

  .case-study-scroll {
    overflow-y: auto;
    height: 100vh;
    position: relative;
    z-index: 10;
  }

  .case-study-body {
    width: max(320px, 60vw);
    margin: 0 auto;
    padding: 5rem 0 8rem;
  }

  @media (min-width: 640px) {
    .case-study-body {
      padding: 7rem 0 8rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-bottom: 3.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: rgba(255, 255, 255, 0.9); }

  .cs-header { margin-bottom: 2.5rem; }

  .cs-context-badge {
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 1rem;
  }

  .cs-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.05em;
    color: #fafaf8;
    margin: 0 0 1rem;
  }

  .cs-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    text-align: justify;
  }

  .cs-delta-heading {
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 1rem;
  }

  .cs-delta-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
  }

  .cs-delta-table th,
  .cs-delta-table td {
    padding: 0.75rem 1rem;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    line-height: 1.5;
    vertical-align: top;
  }

  .cs-delta-table th {
    color: #22d3ee;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.56rem;
    padding-bottom: 0.6rem;
  }

  .cs-delta-table td:first-child {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cs-delta-table td:nth-child(2) {
    color: rgba(255, 255, 255, 0.4);
  }

  .cs-delta-table td:nth-child(3) {
    color: rgba(255, 255, 255, 0.75);
  }

  .cs-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 2rem 0;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.2rem;
    margin: 2rem 0;
  }

  .metric-block { display: flex; flex-direction: column; gap: 4px; }

  .metric-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    color: #22d3ee;
    line-height: 1;
  }

  .metric-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    line-height: 1.4;
  }

  /* ── Toggle ── */
  .cs-tab-toggle {
    display: none;
    gap: 2rem;
    margin: 2rem 0 2.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .cs-tab-btn {
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.55);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 0 0.5rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .cs-tab-btn.active {
    color: #22d3ee;
    border-bottom: 2px solid #22d3ee;
  }

  .cs-tab-btn:hover { color: rgba(255, 255, 255, 0.85); }

  /* ── Panels ── */
  /* All sections are readable until the tab controls have initialized. */
  .cs-tab-panel { display: block; }
  .cs-tabs-ready .cs-tab-toggle { display: flex; }
  .cs-tabs-ready .cs-tab-panel:not(.active) { display: none; }

  /* ── Diagrams ── */
  .cs-diagram-container {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background: transparent;
  }

  .cs-diagram-label {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 0.56rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 1.25rem;
  }

  .mermaid {
    overflow-x: auto;
    background: transparent;
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .mermaid svg {
    max-width: 100%;
    background: transparent !important;
  }

  /* ── Sections ── */
  .cs-section { margin-bottom: 3.5rem; }

  .cs-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fafaf8;
    margin: 0 0 1.2rem;
    letter-spacing: 0.05em;
  }

  .cs-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 0 1rem;
    text-align: justify;
  }

  .cs-body code {
    font-family: 'DM Mono', monospace;
    font-size: 0.85em;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.06);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .cs-body strong { color: #e8e0d0; font-weight: 600; }

  .outcomes-list { display: flex; flex-direction: column; gap: 0; }

  .outcome-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .outcome-metric {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #e8e0d0;
  }

  .outcome-detail {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.35);
  }

  .cs-footer {
    margin-top: 6rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
  }
</style>
