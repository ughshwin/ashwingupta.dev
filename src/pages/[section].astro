---
import { profile } from "../content/portfolio/profile";
import { resolveCopy } from "../content/portfolio/copy";
import { sectionIds } from '../lib/edition-routes';
import { chromeCopy } from '../content/portfolio/chrome';
import sectionTitleSource from '../content/portfolio/section-titles.json';

import { profileSchema, paperSchema } from "../lib/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioHome from '../components/static/PortfolioHome.astro';
import { homeContents } from '../content/portfolio/home';

export function getStaticPaths() {
  return sectionIds.map(section => ({ params: { section } }));
}

const { section } = Astro.params;
const canonical = profile.siteUrl;

const titles: Record<string, string> = resolveCopy(sectionTitleSource);
---

<BaseLayout
  title={titles[section] ?? chromeCopy.schema.profileName}
  canonical={canonical}
  jsonLd={[profileSchema, paperSchema]}
  nativeHome
  contents={homeContents}
>
  <PortfolioHome />
</BaseLayout>
