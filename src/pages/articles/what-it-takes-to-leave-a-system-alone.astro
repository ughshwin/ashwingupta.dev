---
import { resolveCopy } from '../../content/portfolio/copy';

import documentContentSource from "../../content/portfolio/documents/articles--what-it-takes-to-leave-a-system-alone.json";
import { articlePublication as publication } from "../../content/portfolio/articles";
import { contentSchemas } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/index.css";
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;
const description = documentContent.metadata.description;

---

<BaseLayout
  title={documentContent.metadata.baselayout_title}
  description={description}
  canonical={canonical}
  jsonLd={contentSchemas({
    type: "Article",
    datePublished: publication["what-it-takes-to-leave-a-system-alone"].datePublished,
    name: documentContent.metadata.schema_name,
    url: canonical,
    description,
  })}
>
  <div class="spatial-scene">
    <div class="thinking-scroll">
      <div class="thinking-body" role="main">
        <a href={documentContent.links.a_href} class="back-link">{documentContent.blocks.intro_back_link}</a>

        <header class="th-header">
          <div class="th-badge">{documentContent.blocks.intro_th_badge}</div>
          <h1 class="th-title">{documentContent.blocks.what_it_takes_to_leave_a_system_alone_th_title}</h1>
          <p class="th-subtitle">{documentContent.blocks.what_it_takes_to_leave_a_system_alone_th_subtitle}</p>
          <p class="th-byline">{documentContent.blocks.what_it_takes_to_leave_a_system_alone_th_byline}</p>
        </header>

        <div class="th-divider"></div>

        <p class="th-body"><strong>{documentContent.blocks.what_it_takes_to_leave_a_system_alone_strong}</strong></p>
        <p class="th-body">{documentContent.blocks.what_it_takes_to_leave_a_system_alone_th_body}</p>
        <p class="th-body">{documentContent.blocks.what_it_takes_to_leave_a_system_alone_th_body_2}</p>
        <p class="th-body">{documentContent.blocks.what_it_takes_to_leave_a_system_alone_th_body_3}</p>
        <p class="th-body">{documentContent.blocks.what_it_takes_to_leave_a_system_alone_th_body_4} <em>{documentContent.blocks.what_it_takes_to_leave_a_system_alone_em}</em></p>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_work_we_were_trying_to_remove_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.the_work_we_were_trying_to_remove_th_body}</p>
          <p class="th-body">{documentContent.blocks.the_work_we_were_trying_to_remove_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.the_work_we_were_trying_to_remove_th_body_3} <code>{documentContent.blocks.the_work_we_were_trying_to_remove_code}</code> {documentContent.blocks.the_work_we_were_trying_to_remove_th_body_4}</p>
          <p class="th-body"><strong>{documentContent.blocks.the_work_we_were_trying_to_remove_strong}</strong> {documentContent.blocks.the_work_we_were_trying_to_remove_th_body_5}</p>
          <p class="th-body">{documentContent.blocks.the_work_we_were_trying_to_remove_th_body_6}</p>
          <p class="th-body">{documentContent.blocks.the_work_we_were_trying_to_remove_th_body_7}</p>
          <p class="th-body">{documentContent.blocks.the_work_we_were_trying_to_remove_th_body_8}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.what_autonomy_had_to_own_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.what_autonomy_had_to_own_th_body}</p>
          <p class="th-body">{documentContent.blocks.what_autonomy_had_to_own_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.what_autonomy_had_to_own_th_body_3}</p>
          <p class="th-body">{documentContent.blocks.what_autonomy_had_to_own_th_body_4}</p>
          <p class="th-body">{documentContent.blocks.what_autonomy_had_to_own_th_body_5}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.a_checkpoint_is_a_record_of_belief_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.a_checkpoint_is_a_record_of_belief_th_body}</p>
          <p class="th-body">{documentContent.blocks.a_checkpoint_is_a_record_of_belief_th_body_2}</p>
          <p class="th-body"><strong>{documentContent.blocks.a_checkpoint_is_a_record_of_belief_strong}</strong></p>
          <p class="th-body">{documentContent.blocks.a_checkpoint_is_a_record_of_belief_th_body_3}</p>
          <p class="th-body">{documentContent.blocks.a_checkpoint_is_a_record_of_belief_th_body_4}</p>
          <p class="th-body">{documentContent.blocks.a_checkpoint_is_a_record_of_belief_th_body_5}</p>
          <p class="th-body">{documentContent.blocks.a_checkpoint_is_a_record_of_belief_th_body_6}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_hardening_and_softening_loop_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.the_hardening_and_softening_loop_th_body}</p>
          <p class="th-body">{documentContent.blocks.the_hardening_and_softening_loop_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.the_hardening_and_softening_loop_th_body_3}</p>
          <p class="th-body"><em>{documentContent.blocks.the_hardening_and_softening_loop_em}</em> {documentContent.blocks.the_hardening_and_softening_loop_th_body_4}</p>
          <p class="th-body">{documentContent.blocks.the_hardening_and_softening_loop_th_body_5}</p>
          <p class="th-body">{documentContent.blocks.the_hardening_and_softening_loop_th_body_6}</p>
          <p class="th-body">{documentContent.blocks.the_hardening_and_softening_loop_th_body_7}</p>
          <p class="th-body">{documentContent.blocks.the_hardening_and_softening_loop_th_body_8} <strong>{documentContent.blocks.the_hardening_and_softening_loop_strong}</strong> {documentContent.blocks.the_hardening_and_softening_loop_th_body_9}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_environment_kept_moving_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.the_environment_kept_moving_th_body}</p>
          <p class="th-body">{documentContent.blocks.the_environment_kept_moving_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.the_environment_kept_moving_th_body_3}</p>
          <p class="th-body">{documentContent.blocks.the_environment_kept_moving_th_body_4}</p>
          <p class="th-body">{documentContent.blocks.the_environment_kept_moving_th_body_5}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_components_were_necessary_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.the_components_were_necessary_th_body}</p>
          <p class="th-body">{documentContent.blocks.the_components_were_necessary_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.the_components_were_necessary_th_body_3}</p>
          <p class="th-body"><strong>{documentContent.blocks.the_components_were_necessary_strong}</strong> {documentContent.blocks.the_components_were_necessary_th_body_4}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_next_process_was_the_real_test_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.the_next_process_was_the_real_test_th_body}</p>
          <p class="th-body">{documentContent.blocks.the_next_process_was_the_real_test_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.the_next_process_was_the_real_test_th_body_3}</p>
          <p class="th-body">{documentContent.blocks.the_next_process_was_the_real_test_th_body_4} <em>{documentContent.blocks.the_next_process_was_the_real_test_em}</em> {documentContent.blocks.the_next_process_was_the_real_test_th_body_5}</p>
          <p class="th-body">{documentContent.blocks.the_next_process_was_the_real_test_th_body_6}</p>
          <p class="th-body">{documentContent.blocks.the_next_process_was_the_real_test_th_body_7}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_decision_to_stop_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.the_decision_to_stop_th_body}</p>
          <p class="th-body">{documentContent.blocks.the_decision_to_stop_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.the_decision_to_stop_th_body_3}</p>
          <p class="th-body">{documentContent.blocks.the_decision_to_stop_th_body_4}</p>
          <p class="th-body"><strong>{documentContent.blocks.the_decision_to_stop_strong}</strong> {documentContent.blocks.the_decision_to_stop_th_body_5}</p>
        </section>

        <section class="th-section">
          <h2 class="th-section-title">{documentContent.blocks.the_boundary_we_kept_th_section_title}</h2>
          <p class="th-body">{documentContent.blocks.the_boundary_we_kept_th_body}</p>
          <p class="th-body">{documentContent.blocks.the_boundary_we_kept_th_body_2}</p>
          <p class="th-body">{documentContent.blocks.the_boundary_we_kept_th_body_3}</p>
          <p class="th-body">{documentContent.blocks.the_boundary_we_kept_th_body_4}</p>
          <p class="th-body">{documentContent.blocks.the_boundary_we_kept_th_body_5} <strong>{documentContent.blocks.the_boundary_we_kept_strong}</strong> {documentContent.blocks.the_boundary_we_kept_th_body_6}</p>
        </section>

        <p class="th-author-note">{documentContent.blocks.the_boundary_we_kept_th_author_note}</p>
        <div class="th-footer"><span>{documentContent.blocks.the_boundary_we_kept_span}</span></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  body {
    background: #060608;
    margin: 0;
    padding: 0;
  }

  .thinking-scroll {
    overflow-y: auto;
    height: 100vh;
    position: relative;
    z-index: 10;
  }

  .thinking-body {
    --prose-gap: 1.1rem;
    /* Preserve the former divider: two prose gaps plus its 0.7rem line box. */
    --section-gap: calc(var(--prose-gap) + var(--prose-gap) + 0.7rem);
    width: max(320px, 60vw);
    margin: 0 auto;
    padding: 5rem 0 8rem;
  }

  @media (min-width: 640px) {
    .thinking-body {
      padding: 7rem 0 8rem;
    }
  }

  /* Navigation */
  .back-link {
    display: inline-flex;
    align-items: center;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-bottom: 3.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: rgba(255, 255, 255, 0.9); }

  /* Header */
  .th-header { margin-bottom: 2rem; }

  .th-badge {
    font-family: 'DM Mono', monospace;
    font-size: 0.54rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 1.1rem;
  }

  .th-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0.04em;
    color: #fafaf8;
    margin: 0 0 0.5rem;
  }

  .th-subtitle {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 400;
    font-style: italic;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 1rem;
  }

  .th-byline {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.28);
    margin: 0;
  }

  /* Dividers */
  .th-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 2.5rem 0;
  }

  /* Sections */
  .th-section { margin: var(--section-gap) 0 0; }

  .th-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    line-height: 1.4;
    font-weight: 800;
    color: #fafaf8;
    margin: 0 0 var(--prose-gap);
    letter-spacing: 0.04em;
  }

  /* Body prose */
  .th-body {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 var(--prose-gap);
  }

  .th-body em { color: rgba(255, 255, 255, 0.8); font-style: italic; }
  .th-body strong { color: #e8e0d0; font-weight: 600; }

  /* Closing author note */
  .th-author-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.28);
    font-style: italic;
    margin: var(--section-gap) 0 6rem;
  }

  /* Footer */
  .th-footer {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
  }
</style>
