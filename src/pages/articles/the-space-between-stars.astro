<style>
  body {
    background: #060608;
    margin: 0;
    padding: 0;
  }

  .thinking-scroll {
    overflow-y: auto;
    height: 100vh;
    position: relative;
    z-index: 10;
  }

  .thinking-body {
    width: max(320px, 60vw);
    margin: 0 auto;
    padding: 5rem 0 8rem;
  }

  @media (min-width: 640px) {
    .thinking-body {
      padding: 7rem 0 8rem;
    }
  }

  /* Navigation */
  .back-link {
    display: inline-flex;
    align-items: center;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    margin-bottom: 3.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: rgba(255, 255, 255, 0.9); }

  /* Header */
  .th-header { margin-bottom: 2rem; }

  .th-badge {
    font-family: 'DM Mono', monospace;
    font-size: 0.54rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 1.1rem;
  }

  .th-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0.04em;
    color: #fafaf8;
    margin: 0 0 0.5rem;
  }

  .th-subtitle {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 400;
    font-style: italic;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 1rem;
  }

  .th-byline {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.28);
    margin: 0;
  }

  /* Dividers */
  .th-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 2.5rem 0;
  }

  .th-section-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 3rem 0;
  }

  .th-section-divider-mark {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.18);
  }

  /* Sections */
  .th-section { margin-bottom: 3rem; }

  .th-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 800;
    color: #fafaf8;
    margin: 0 0 1.4rem;
    letter-spacing: 0.04em;
  }

  /* Body prose */
  .th-body {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1.1rem;
  }

  .th-body em { color: rgba(255, 255, 255, 0.8); font-style: italic; }
  .th-body strong { color: #e8e0d0; font-weight: 600; }

  .th-body--closing {
    color: rgba(255, 255, 255, 0.75);
    font-style: italic;
  }

  /* Closing author note */
  .th-author-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.28);
    font-style: italic;
    margin: 0 0 6rem;
  }

  /* Footer */
  .th-footer {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
  }
</style>
