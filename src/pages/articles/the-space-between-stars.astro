---
import { resolveCopy } from '../../content/portfolio/copy';

import documentContentSource from "../../content/portfolio/documents/articles--the-space-between-stars.json";
import { articlePublication as publication } from "../../content/portfolio/articles";
import { contentSchemas } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/index.css";
const documentContent = resolveCopy(documentContentSource);

const canonical = documentContent.metadata.canonical;

---

<BaseLayout
  title={documentContent.metadata.baselayout_title}
  description={documentContent.metadata.baselayout_description}
  canonical={canonical}
  jsonLd={contentSchemas({
    type: "Article",
    datePublished: publication["the-space-between-stars"].datePublished,
    name: documentContent.metadata.schema_name,
    url: canonical,
    description: documentContent.metadata.baselayout_description,
  })}
>
  <div class="spatial-scene">
    <div class="thinking-scroll">
      <div class="thinking-body" role="main">

        <a href={documentContent.links.a_href} class="back-link">{documentContent.blocks.intro_back_link}</a>

        <header class="th-header">
          <div class="th-badge">{documentContent.blocks.intro_th_badge}</div>
          <h1 class="th-title">{documentContent.blocks.the_space_between_stars_th_title}</h1>
          <p class="th-subtitle">{documentContent.blocks.the_space_between_stars_th_subtitle}</p>
          <p class="th-byline">{documentContent.blocks.the_space_between_stars_th_byline}</p>
        </header>

        <div class="th-divider"></div>

        <p class="th-body">
          {documentContent.blocks.the_space_between_stars_th_body}
        </p>
        <p class="th-body">
          {documentContent.blocks.the_space_between_stars_th_body_2}
        </p>
        <p class="th-body">
          {documentContent.blocks.the_space_between_stars_th_body_3}
        </p>

        <div class="th-section-divider">
          <span class="th-section-divider-mark">• • •</span>
