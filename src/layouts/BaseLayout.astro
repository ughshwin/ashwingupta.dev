---
import { personSchema, websiteSchema } from "../lib/structured-data";
import { ClientRouter } from "astro:transitions";
import { PageBackground } from "../app/components/PageBackground";
import { ClockWidget } from "../app/components/ClockWidget";
import { BottomRightHUD } from "../app/components/BottomRightHUD";
import Entrance from "../components/Entrance.astro";
import "@fontsource/playfair-display/800.css";
import "@fontsource/playfair-display/400-italic.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-mono/400.css";
import dmSans400Url from "@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url";
import playfair800Url from "@fontsource/playfair-display/files/playfair-display-latin-800-normal.woff2?url";
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  jsonLd?: object[];
}

const {
  title = "Ashwin Gupta - AI Systems Engineer",
  description = "Inference routing. Concurrency architecture. Physics-informed ML. An AI Systems Engineer who thinks in systems and in design - building what surrounds the model, not just the model itself. Bangalore.",
  canonical = "https://www.ashwingupta.dev/",
  image = "https://www.ashwingupta.dev/og-image.jpg",
  jsonLd = [],
} = Astro.props;
const pageSchemas = jsonLd.map((schema) => ({
  ...schema,
  ...((schema as Record<string, string>).url === canonical && ["Article", "ScholarlyArticle", "WebPage", "ProfilePage", "CollectionPage"].includes((schema as Record<string, string>)["@type"]) ? { image } : {}),
}));
const article = jsonLd.find((schema) => (schema as Record<string, string>).url === canonical && ["Article", "ScholarlyArticle"].includes((schema as Record<string, string>)["@type"])) as Record<string, string> | undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={dmSans400Url} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={playfair800Url} as="font" type="font/woff2" crossorigin="anonymous" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ashwin Gupta" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

    <meta property="og:type" content={article ? "article" : "website"} />
    {article?.datePublished && <meta property="article:published_time" content={article.datePublished} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1728" />
    <meta property="og:image:height" content="910" />
    <meta property="og:image:alt" content="Ashwin Gupta - AI Systems Engineer. Inference routing, concurrency architecture, physics-informed ML." />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ashwingupta3012" />
    <meta name="twitter:creator" content="@ashwingupta3012" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {[personSchema, websiteSchema, ...pageSchemas].map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
    ))}

    <ClientRouter />
    <script is:inline>
      // Run before paint. No JS means no gate; deep links always open directly.
      if (!window.__portfolioEntranceChecked) {
        window.__portfolioEntranceChecked = true;
        let entered = false;
        try { entered = sessionStorage.getItem('portfolio:entered') === '2'; } catch {}
        if (location.pathname === '/' && !location.hash && !entered) {
          document.documentElement.dataset.entrance = 'waiting';
          setTimeout(() => {
            if (!document.documentElement.dataset.entranceMounted) {
              delete document.documentElement.dataset.entrance;
              document.getElementById('entrance')?.setAttribute('hidden', '');
              document.getElementById('site-content')?.removeAttribute('inert');
            }
          }, 6000);
        }
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <PageBackground client:load transition:persist="site-bg" />
    <div id="site-chrome">
    <ClockWidget client:idle transition:persist="clock-widget" />
    <BottomRightHUD client:idle transition:persist="bottom-right-hud" />
    <div transition:persist="bottom-fade" style="position:fixed;bottom:0;left:0;right:0;height:5.5rem;background:linear-gradient(to top,rgba(6,6,8,0.72) 0%,transparent 100%);pointer-events:none;z-index:48;" />
    </div>
    <div id="site-content"><slot /></div>
    <Entrance />
  </body>
</html>
