---
import { profile, siteTitle, siteDescription, socialImage } from "../content/portfolio/profile";
import ReviewLayout from './ReviewLayout.astro';

const {
  title = siteTitle,
  description = siteDescription,
  canonical = profile.siteUrl,
  image = socialImage,
  jsonLd = [],
  nativeHome = false,
  contents = [],
} = Astro.props;
const schemas = jsonLd.map(schema => ({...schema,...(schema.url === canonical && ['Article','ScholarlyArticle','WebPage','ProfilePage','CollectionPage'].includes(schema['@type']) ? {image} : {})}));
---
<ReviewLayout {title} {description} {canonical} {image} jsonLd={schemas} {nativeHome} {contents}>
  <slot />
  <slot name="head" slot="head" />
</ReviewLayout>
