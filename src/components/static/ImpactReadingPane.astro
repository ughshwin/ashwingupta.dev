---
import { resolveCopy } from '../../content/portfolio/copy';
import source from '../../content/portfolio/copy/Impact.json';
import { CATEGORY_ORDER, getKaggleFreshness, impactCategories, impacts } from '../../content/portfolio/impact';

const copy = resolveCopy(source);
const sourceLabels: Readonly<Record<string, string>> = copy.sourceLabels;
const groups = CATEGORY_ORDER.map(category => {
  const items = impacts.filter(metric => metric.category === category);
  return {
    category,
    label: impactCategories[category].label,
    items,
  };
}).filter(group => group.items.length);
const initial = groups[0]?.category;
const freshness = getKaggleFreshness({ stats: null, status: 'recorded' });
---

<section id="impact" aria-labelledby="impact-heading">
  <span class="rv-label">{copy.impact}</span>
  <h2 id="impact-heading">{copy.results_by_area}</h2>

  <div class="ledger-reader">
    <div class="ledger-reader-buttons" role="group" aria-label={copy.result_areas}>
      {groups.map(({ category, label }) => (
        <button class="ledger-area-button" type="button" data-impact-area={category}
          aria-controls={`impact-results-${category}`} aria-pressed={category === initial ? 'true' : 'false'}>
          {label}
        </button>
      ))}
    </div>
    <label class="ledger-reader-select">
      <span class="rv-label">{copy.result_area}</span>
      <select>
        {groups.map(({ category, label }) => (
          <option value={category} selected={category === initial}>{label}</option>
        ))}
      </select>
    </label>
    <div class="ledger-reader-results">
      {groups.map(({ category, label, items }) => (
        <section id={`impact-results-${category}`} data-impact-results={category}
          aria-labelledby={`impact-title-${category}`} hidden={category !== initial}>
          <h3 id={`impact-title-${category}`}>{label}</h3>
          <ul class="ledger-records">
            {items.map(metric => (
              <li class="rv-card ledger-record" data-kaggle-stat={metric.liveStat}>
                <p>
                  <strong data-kaggle-value={metric.liveStat ? '' : undefined}>{metric.result ?? metric.value}</strong>{' '}{metric.label}
                </p>
                <span class="rv-label ledger-source">
                  {sourceLabels[metric.projectId ?? ''] ?? metric.item}
                  {metric.liveStat && <> · <span data-kaggle-freshness title={freshness.detail}>{freshness.label}</span></>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <span class="ledger-status" role="status"></span>
  </div>
</section>

<script>
  const impact = document.getElementById('impact');
  if (impact) {
    const buttons = impact.querySelectorAll<HTMLButtonElement>('[data-impact-area]');
    const panels = impact.querySelectorAll<HTMLElement>('[data-impact-results]');
    const picker = impact.querySelector('select')!;
    const status = impact.querySelector('[role="status"]')!;

    function showArea(area: string) {
      picker.value = area;
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.impactArea === area));
      for (const panel of panels) panel.hidden = panel.dataset.impactResults !== area;
      status.textContent = picker.selectedOptions[0].textContent;
    }

    for (const button of buttons) button.addEventListener('click', () => showArea(button.dataset.impactArea!));
    picker.addEventListener('change', () => showArea(picker.value));
  }
</script>

<style>
  #impact { container-type: inline-size; }
  #impact > :is(.rv-label, h2) {
    text-align: start !important;
  }
  #impact .ledger-reader-select > .rv-label {
    display: block;
    margin-inline: 0;
  }
  #impact h3,
  #impact .ledger-reader-select > .rv-label,
  #impact .ledger-record :is(p, .ledger-source) {
    text-align: center !important;
  }
  .ledger-reader-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-bottom: 28px;
  }
  .ledger-area-button {
    min-block-size: 44px;
    padding: 8px 0;
    border: 0;
    border-block-end: 1px solid transparent;
    background: none;
    color: var(--rv-muted);
    font: inherit;
    font-size: 14px;
    text-align: start;
    cursor: pointer;
  }
  .ledger-area-button:hover,
  .ledger-area-button[aria-pressed='true'] {
    border-block-end-color: var(--rv-accent);
    color: var(--rv-accent);
  }
  #impact .ledger-records {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #impact .ledger-record {
    position: relative;
    margin: 0;
    padding-block: 14px;
    border-block-start: 0;
    overflow-wrap: anywhere;
  }
  #impact .ledger-record + .ledger-record::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    inline-size: min(44%, 18rem);
    margin-inline: auto;
    border-block-start: 1px solid var(--rv-rule);
  }
  #impact .ledger-record p {
    margin: 0 auto;
    line-height: 1.55;
  }
  #impact .ledger-source {
    display: block;
    margin: 3px 0 0;
  }
  .ledger-reader-select { display: none; }
  .ledger-reader-select select {
    width: 100%;
    min-block-size: 44px;
    padding: 6px 8px;
    border: 1px solid var(--rv-rule);
    border-radius: 0;
    background: var(--rv-paper);
    color: var(--rv-ink);
    font: inherit;
    font-size: 16px;
  }
  .ledger-status {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @container (max-width: 520px) {
    .ledger-reader-buttons { display: none; }
    .ledger-reader-select { display: block; margin-bottom: 28px; }
  }
  @media print, (scripting: none) {
    .ledger-reader-buttons, .ledger-reader-select { display: none; }
    .ledger-reader-results > section[hidden] { display: block; }
    .ledger-reader-results > section + section { margin-top: 20px; }
  }
</style>
