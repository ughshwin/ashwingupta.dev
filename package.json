{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "check:seo": "node scripts/verify-seo.mjs",
    "sync:seo": "node scripts/sync-seo.mjs && node scripts/sync-discovery.mjs",
    "check:seo:config": "node scripts/sync-seo.mjs --check && node scripts/sync-discovery.mjs --check",
    "prebuild": "npm run check:data && npm run sync:seo && node scripts/build-review-svg-assets.mjs",
    "postbuild": "node scripts/build-discovery.mjs",
    "build:verified": "npm run build && npm run check:types && npm run check:seo && npm run check:content && npm run check:review",
    "check:review": "node scripts/verify-review.mjs",
    "check:seo:live": "node scripts/verify-seo-live.mjs",
    "check:content": "node scripts/verify-content.mjs",
    "notify:indexnow": "node scripts/notify-indexnow.mjs",
    "notify:indexnow:preview": "node scripts/notify-indexnow.mjs --dry-run",
    "check:data": "node scripts/verify-portfolio-data.mjs && node scripts/test-portfolio-data.mjs",
    "check:migration": "node scripts/verify-content-migration.mjs",
    "test:content:render": "node scripts/test-content-render.mjs",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.4.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.69.0",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "parse5": "8.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
